---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - 페이지를 찾을 수 없습니다 | AI Insights" description="요청하신 페이지를 찾을 수 없습니다.">
	<div class="flex flex-col min-h-screen items-center justify-center px-4">
		<div class="text-center max-w-md">
			<span class="material-symbols-outlined text-8xl text-slate-300 dark:text-slate-700 mb-4 block">search_off</span>
			<h1 class="text-6xl font-extrabold text-primary mb-4">404</h1>
			<h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">페이지를 찾을 수 없습니다</h2>
			<p class="text-slate-500 dark:text-slate-400 mb-8 leading-relaxed">
				요청하신 페이지가 존재하지 않거나 이동되었습니다.<br />
				아래 버튼을 눌러 홈으로 돌아가세요.
			</p>
			<a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-semibold rounded-xl hover:bg-primary/90 transition-colors shadow-md">
				<span class="material-symbols-outlined">home</span>
				홈으로 돌아가기
			</a>
		</div>
	</div>
</Layout>
